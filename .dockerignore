# Build context for the web image (context = repo root). Keep it lean and never
# bake secrets into the image.
node_modules
.next
out
build
.git
.idea
*.tsbuildinfo
next-env.d.ts

# local DBs / leftovers
prisma/*.db
prisma/*.db-journal

# settings + secrets — never copy into the image (compose passes them at runtime)
settings.yml
.env
.env.*
docker/.compose.env

# deployment folders (compose files, secrets, retired services) — not app source.
# The web Dockerfile still needs docker.example/web/entrypoint.sh (the template
# copy, which a GitHub build has too), so that stays in.
docker
docker.example/*
!docker.example/web

# docs / unrelated
docs
HomeAssistant
