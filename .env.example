# Our Home: secrets only. Copy to .env (gitignored) and fill in. Never commit
# the real file. Every other setting is in settings.yml (template:
# settings.example.yml).
#
# Local dev reads this file directly; Docker passes it to the container.
# A DEV_ entry replaces its name for `npm run dev` (empty = off in dev), so one
# file serves both.
#
# Generate secrets/passwords as hex (no URL-encoding needed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Session signing secret, 32+ random bytes.
BETTER_AUTH_SECRET=replace-with-a-32-byte-hex-secret

# Your MongoDB (a replica set; the app uses transactions), as the web container
# reaches it. It's here because it holds the database password.
DATABASE_URL=mongodb://household:replace-with-a-strong-hex-password@mongo:27017/household?replicaSet=rs0&authSource=admin
# The same database as seen from your PC (directConnection skips replica-set
# discovery).
DEV_DATABASE_URL=mongodb://household:replace-with-a-strong-hex-password@localhost:27018/household?directConnection=true&authSource=admin

# Bearer secret for POST /api/cron/reminders, to trigger a sweep by hand or from
# outside. Optional: the server runs the sweep itself every 15 minutes.
CRON_SECRET=replace-with-a-random-hex-secret

# --- Optional, each next to its settings.yml section -------------------------
# smtp: the SMTP password (or token).
SMTP_PASS=
# turnstile: the Cloudflare Turnstile secret key.
TURNSTILE_SECRET_KEY=
DEV_TURNSTILE_SECRET_KEY=
# Instant phone alerts: the Firebase service-account key, base64 on one line:
#   base64 -w0 service-account.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Empty = off. Setup: docs/push-notifications.md
FIREBASE_SERVICE_ACCOUNT=
DEV_FIREBASE_SERVICE_ACCOUNT=
# paperless: the API token of a read-only Paperless user.
PAPERLESS_TOKEN=
DEV_PAPERLESS_TOKEN=
