# Our Home — the one settings file, for both local dev and the Docker deploy.
# Copy to .env (gitignored) and fill in. Never commit the real file.
#
#   - Local dev (npm run dev, prisma, tests) reads it directly.
#   - Docker (docker/docker-compose.yml) loads it into the containers and
#     overrides the few values that differ on the server: see "Server only".
#
# There are no accounts in here: on first start, open the site by the server's
# address (http://<server-ip>:3000) and the setup page creates the admin and
# the rest of the household.
#
# Generate secrets/passwords as hex (no URL-encoding needed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- App (dev + server) ------------------------------------------------------
# Name shown in the browser tab, sign-in page, and emails.
APP_NAME=Our Home
# 32+ random bytes.
BETTER_AUTH_SECRET=replace-with-a-32-byte-hex-secret
# Comma-separated extra origins allowed to sign in. Usually empty: the public
# URL and any home-network address (IP or hostname) are already allowed.
BETTER_AUTH_TRUSTED_ORIGINS=
# Bearer secret for POST /api/cron/reminders, to trigger a sweep by hand or from
# outside. Optional: the server runs the sweep itself every 15 minutes.
CRON_SECRET=replace-with-a-random-hex-secret

# --- Local dev only ----------------------------------------------------------
# URL of `npm run dev`. On the server, compose replaces it with PUBLIC_URL.
BETTER_AUTH_URL=http://localhost:3000
# MongoDB as seen from your PC (directConnection skips replica-set discovery).
# On the server, compose uses SERVER_DATABASE_URL instead.
DATABASE_URL=mongodb://household:replace-with-a-strong-hex-password@localhost:27018/household?directConnection=true&authSource=admin

# --- Server only (used by docker/docker-compose.yml) ------------------------
# Optional. The https:// address the site is reached at from outside (a tunnel
# or reverse proxy), used for links in emails. Empty = home network only.
PUBLIC_URL=
# Host port for the web container.
WEB_HOST_PORT=3000
# Where that port listens: 0.0.0.0 = every device on your network can open the
# site; 127.0.0.1 = only this machine (and a tunnel/proxy running on it).
WEB_BIND=0.0.0.0
# Docker network the web container joins (created by the deploy scripts if
# missing). Put your MongoDB container on it to reach it by name.
DOCKER_NETWORK=ourhome_net

# --- Database (server) ------------------------------------------------------
# Your MongoDB, as the web container reaches it. It must be a replica set (the
# app uses transactions) and is not started by this project. Compose passes
# this as DATABASE_URL.
SERVER_DATABASE_URL=mongodb://household:replace-with-a-strong-hex-password@mongo:27017/household?replicaSet=rs0&authSource=admin

# --- Email (SMTP) — optional -------------------------------------------------
# SERVER_SMTP_HOST turns email on for the server only (compose passes it as
# SMTP_HOST); local dev has no SMTP_HOST, so it just logs emails. Empty = off.
# Works with any SMTP provider (e.g. Proton Mail SMTP submission on port 587).
SERVER_SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where contact-form messages are forwarded. Empty = stored but not forwarded.
CONTACT_FORWARD_TO=
# Where bug reports are emailed. Empty = stored + in-app notification only.
BUG_REPORT_EMAIL=

# --- Contact form CAPTCHA (Cloudflare Turnstile) — optional, server only ------
# Keys are tied to your domain, so compose passes them to the server only.
SERVER_TURNSTILE_SITE_KEY=
SERVER_TURNSTILE_SECRET_KEY=

# --- Instant phone alerts (Firebase Cloud Messaging) — optional, server only --
# Lets the Android app alert instantly instead of on its hourly check. Pushes
# carry no content (only "something changed"); the phone fetches the details
# from this server. Paste the Firebase service-account key, base64-encoded onto
# one line (raw single-line JSON also works):
#   base64 -w0 service-account.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Empty = off: phones keep their hourly check. Setup: docs/push-notifications.md
SERVER_FIREBASE_SERVICE_ACCOUNT=

# --- Paperless-ngx bill import — optional, server only ---------------------------
# Documents tagged "bill" / "bill-payment" in Paperless become bills and payments,
# checked every 15 minutes. Starts from the moment it's first switched on: nothing
# already in Paperless is imported. Setup: docs/paperless-import.md
# How the web container reaches Paperless (on the shared Docker network), and a
# token for a read-only Paperless user. Either empty = import off.
SERVER_PAPERLESS_URL=
SERVER_PAPERLESS_TOKEN=
# Address you open Paperless at in a browser, for "Open in Paperless" links. Optional.
PAPERLESS_PUBLIC_URL=
# Only if your Paperless uses other names (defaults shown):
# PAPERLESS_BILL_TAG=bill
# PAPERLESS_PAYMENT_TAG=bill-payment
# PAPERLESS_PENDING_TAGS=paperless-gpt
# PAPERLESS_FIELD_AMOUNT=Amount
# PAPERLESS_FIELD_DUE_DATE=Due date
# PAPERLESS_FIELD_ACCOUNT=Account number
# PAPERLESS_FIELD_INVOICE=Invoice number

# --- Security header tuning — optional ---------------------------------------
# true = Content-Security-Policy in report-only mode (debugging only).
CSP_REPORT_ONLY=
