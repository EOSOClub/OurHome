# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma — leftover local sqlite db from the pre-MongoDB setup
/prisma/*.db
/prisma/*.db-journal

# Private deployment: real compose, .env secrets, deploy scripts, retired
# services. The public template is docker.example/ (copy it to docker/).
/docker/

# Retired / never-public folders, in case they reappear
/stacks/
/proton-parser/
__pycache__/
*.py[cod]
.pytest_cache/

# IDE + local AI-assistant notes
/.idea/
/.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
