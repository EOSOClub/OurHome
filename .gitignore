# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Your settings and secrets. Only the templates (settings.example.yml,
# .env.example) are public. Also covers .env backups like .env.bak.
/settings.yml
.env*
!.env.example

# Your deployment copy of docker.example/ (cp -r docker.example docker).
/docker/
# The Android app the deploy builds: its signing key + password, the Firebase
# file, and the built APK. Back up release.jks and keystore.env.
/android/
# Generated by the deploy scripts from settings.yml.
.compose.env
# What the last deploy built (deploy.sh -y compares against it).
.web-build

# IDE + local AI-assistant notes. The inspection profile, its scopes and the
# project dictionary are shared, so every checkout inspects the same way.
/.idea/*
!/.idea/inspectionProfiles/
!/.idea/scopes/
!/.idea/dictionaries/
/.claude/
/CLAUDE.md
# Written and rewritten by `next dev` for AI coding tools.
/AGENTS.md

# The maintainer's own dev work: planning notes, and the demo household and
# scripts that take the wiki's screenshots. Not needed to build, run or deploy.
/TODO.md
/tools/wiki-screenshots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
